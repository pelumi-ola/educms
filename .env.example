PORT=5000
NODE_ENV=development
API_VERSION=v1

# Local DB (on Heroku DATABASE_URL is set for you and takes priority)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educms_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_REFRESH_EXPIRE=30d

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@educms.com

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Seeding (used by `npm run migrate` when SEED=true)
SEED=true
ADMIN_PASSWORD=admin123
